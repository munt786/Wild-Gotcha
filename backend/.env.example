# WildGotcha Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# MongoDB Atlas or Local MongoDB Connection URI
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Example Local URI: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=wildgotcha_db

# CORS configuration (use comma-separated list or * for development)
CORS_ORIGINS=*

# Minimum model confidence threshold (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.15
