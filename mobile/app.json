{
  "expo": {
    "name": "WildGotcha",
    "slug": "wildgotcha",
    "scheme": "wildgotcha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#091217"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wildgotcha.app",
      "infoPlist": {
        "NSCameraUsageDescription": "WildGotcha requires camera access to scan and classify mammals, insects, reptiles, and arachnids.",
        "NSPhotoLibraryUsageDescription": "WildGotcha requires photo library access so you can identify species from existing gallery pictures."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#091217"
      },
      "package": "com.wildgotcha.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "WildGotcha needs camera access to capture and identify species in real-time."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WildGotcha requires access to your photos to identify wildlife creatures from your album."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "3ea456f0-5d38-4938-b713-78ab28f25c4c"
      }
    },
    "owner": "mohammad_muntazir_ahmad"
  }
}
